############################
# STEP 1 build executable binary
############################
FROM golang:1.27

SHELL ["cmd", "/S", "/C"]

WORKDIR /src

COPY go.* ./

RUN go mod download

COPY . ./

ENV CGO_ENABLED=0

ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME

RUN go build -o ./ -ldflags=" \
    -X 'github.com/gorse-io/gorse/cmd/version.Version=%VERSION%' \
    -X 'github.com/gorse-io/gorse/cmd/version.GitCommit=%GIT_COMMIT%' \
    -X 'github.com/gorse-io/gorse/cmd/version.BuildTime=%BUILD_TIME%'" ./cmd/...

############################
# STEP 2 build a small image
############################
FROM mcr.microsoft.com/windows/servercore:ltsc2022

COPY --from=0 /src/gorse-server.exe /gorse-server.exe

RUN /gorse-server.exe --version

ENTRYPOINT [ "/gorse-server.exe" ]
