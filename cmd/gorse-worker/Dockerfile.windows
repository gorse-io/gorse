############################
# STEP 1 build executable binary
############################
FROM golang:1.27

WORKDIR /src

COPY go.* ./

RUN go mod download

COPY . ./

ENV CGO_ENABLED=0

ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME

RUN go build -o ./ -ldflags ('-X github.com/gorse-io/gorse/cmd/version.Version={0} -X github.com/gorse-io/gorse/cmd/version.GitCommit={1} -X github.com/gorse-io/gorse/cmd/version.BuildTime={2}' -f $env:VERSION, $env:GIT_COMMIT, $env:BUILD_TIME) ./cmd/...

############################
# STEP 2 build a small image
############################
FROM mcr.microsoft.com/windows/servercore:ltsc2022

COPY --from=0 /src/gorse-worker.exe /gorse-worker.exe

RUN /gorse-worker.exe --version

ENTRYPOINT [ "/gorse-worker.exe" ]
