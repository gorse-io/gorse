############################
# STEP 1 build executable binary
############################
FROM golang:1.27

WORKDIR /src

COPY go.* ./

RUN go mod download

COPY . ./

ENV CGO_ENABLED=0

ARG VERSION
ARG GIT_COMMIT
ARG BUILD_TIME

RUN $ldflags = '-X github.com/gorse-io/gorse/cmd/version.Version=' + $env:VERSION + \
    ' -X github.com/gorse-io/gorse/cmd/version.GitCommit=' + $env:GIT_COMMIT + \
    ' -X github.com/gorse-io/gorse/cmd/version.BuildTime=' + $env:BUILD_TIME; \
    go build -o ./ -ldflags $ldflags ./cmd/...

############################
# STEP 2 build a small image
############################
FROM mcr.microsoft.com/windows/servercore:ltsc2022

COPY --from=0 /src/gorse-in-one.exe /gorse-in-one.exe

RUN /gorse-in-one.exe --version

ENTRYPOINT [ "/gorse-in-one.exe" ]
